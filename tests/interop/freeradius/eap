# mods-available/eap for the interop home server: EAP-TLS only, with the test CA
# from tests/interop/certs. TLS 1.3 is allowed (FreeRADIUS 3.2 supports it for
# EAP-TLS, RFC 9190); the supplicant decides which version is negotiated.
eap {
    default_eap_type = tls
    timer_expire = 60
    ignore_unknown_eap_types = no
    cisco_accounting_username_bug = no
    max_sessions = ${max_requests}

    tls-config tls-common {
        private_key_file = /etc/freeradius/interop-certs/freeradius-server.key
        certificate_file = /etc/freeradius/interop-certs/freeradius-server.crt
        ca_file = /etc/freeradius/interop-certs/ca.crt

        tls_min_version = "1.2"
        tls_max_version = "1.3"
        cipher_list = "DEFAULT"
        cipher_server_preference = no
        ecdh_curve = "prime256v1"
        fragment_size = 1024
        include_length = yes
        check_crl = no

        cache {
            enable = no
        }
        verify {
        }
        ocsp {
            enable = no
        }
    }

    tls {
        tls = tls-common
        require_client_cert = yes
    }
}
