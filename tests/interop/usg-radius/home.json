{
  "_comment": "usg-radius as an EAP-TLS home server (no proxy): validates its own MS-MPPE key emission and the TLS 1.3 exporter labels against eapol_test.",
  "listen_address": "0.0.0.0",
  "listen_port": 1812,
  "transport": "udp-insecure",
  "secret": "unused-default-secret",
  "clients": [
    { "name": "nas (eapol_test)", "address": "10.77.0.40/32", "secret": "nas-usghome-secret-3" }
  ],
  "users": [],
  "verbose": true,
  "log_level": "debug",
  "strict_rfc_compliance": true,
  "eap": {
    "enable_tls": true,
    "enable_teap": false,
    "tls": {
      "cert_path": "/certs/usg-home-server.crt",
      "key_path": "/certs/usg-home-server.key",
      "ca_path": "/certs/ca.crt",
      "require_client_cert": true
    }
  }
}
